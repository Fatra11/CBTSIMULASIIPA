            // Build HTML
            let html = `<div class="mb-6 fade-in">${q.text.replace(/\n/g, '<br>')}</div>`;

            const userAns = state.answers[q.id]; // Ex: 1, [0,2], {"0":"B"}, {"0":2}
            
