        /* --- LOGIC: LOGIN & PACT --- */
        function verifyLogin() {
            const nama = get('in-nama').value.trim();
            const kelas = get('in-kelas').value;
            const token = get('in-token').value.trim();
            const err = get('err-login');

            if(!nama || !kelas || !token) {
                err.innerText = "Lengkapi semua data form!";
                show('err-login'); return;
            }
            if(token !== APP_CONFIG.token) {
                err.innerText = "Token Ujian Salah!";
                show('err-login'); return;
            }

            hide('err-login');
            state.student = { nama, kelas };
            state.status = "pact";
            hide('screen-login');
            show('screen-pact');
        }

        function startExam() {
            state.status = "test";
            state.seed = Math.random(); // Can use seed to shuffle if needed, keeping static for simplicity per PDF order.
            
            // Fullscreen attempt (must be driven by user gesture)
            requestFullscreen();
            
            hide('screen-pact');
            show('screen-test');
            
            initTestUI();
            startTimer();
            setupAntiCheat();
        }

        function resumeExam() {
            hide('screen-login');
            show('screen-test');
            initTestUI();
            startTimer();
            setupAntiCheat();
        }

        function requestFullscreen() {
            try {
                const docElm = document.documentElement;
                if (docElm.requestFullscreen) { 
                    const promise = docElm.requestFullscreen();
                    if (promise && promise.catch) {
                        promise.catch(e => console.warn("Fullscreen dicegah oleh policy browser", e));
                    }
                }
                else if (docElm.webkitRequestFullScreen) { 
                    docElm.webkitRequestFullScreen(); 
                }
            } catch (err) {
                console.warn("Fullscreen API tidak didukung:", err);
            }
        }

        /* --- LOGIC: TEST WORKSPACE --- */
        function initTestUI() {
            get('ui-student-name').innerText = `${state.student.nama} (${state.student.kelas})`;
            get('ui-violations').innerText = state.violations;
            
            buildSidebarGrid();
            renderQuestion(state.currentIndex);
        }

        function startTimer() {
            if(timerInterval) clearInterval(timerInterval);
            updateTimerUI();
            timerInterval = setInterval(() => {
                state.timeRemaining--;
                updateTimerUI();
                saveState(); // auto save every sec
                if(state.timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    forceSubmit();
                }
            }, 1000);
        }

        function updateTimerUI() {
            const h = Math.floor(state.timeRemaining / 3600);
            const m = Math.floor((state.timeRemaining % 3600) / 60);
            const s = state.timeRemaining % 60;
            const text = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
            get('ui-timer').innerText = text;
            
            if(state.timeRemaining < 300) { // < 5 mins
                get('ui-timer-box').classList.add('bg-red-900/80', 'animate-pulse');
                get('ui-timer-box').classList.remove('bg-slate-900/40');
