                grid.appendChild(btn);
            });
            updateSidebarVisuals();
        }

        function updateSidebarVisuals() {
            BANK_SOAL.forEach((q, idx) => {
                const btn = get(`nav-${idx}`);
                btn.className = `btn-nav w-full aspect-square flex items-center justify-center font-bold rounded-lg border transition`;
                
                // Color logic
                if(state.answers[q.id] !== undefined && state.answers[q.id] !== null && Object.keys(state.answers[q.id]).length !== 0) {
                    btn.classList.add('answered');
                } else {
                    btn.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
                }
                
                if(state.ragu[q.id]) {
                    btn.classList.remove('answered', 'bg-white', 'text-slate-600', 'border-slate-200');
                    btn.classList.add('ragu');
                }
                
                // Active highlight
                if(idx === state.currentIndex) {
                    btn.classList.add('active');
                }
            });
        }

        function toggleSidebar() {
            const sb = get('sidebar');
            if(sb.classList.contains('-translate-x-full')) sb.classList.remove('-translate-x-full');
            else sb.classList.add('-translate-x-full');
        }
        function closeSidebarMobile() {
            if(window.innerWidth < 768) get('sidebar').classList.add('-translate-x-full');
        }

        function changeFontSize(dir) {
            if(dir === 0) fontSizeScale = 1;
            else if(dir > 0 && fontSizeScale < 1.4) fontSizeScale += 0.2;
            else if(dir < 0 && fontSizeScale > 0.8) fontSizeScale -= 0.2;
            
            get('q-content').style.fontSize = `${16 * fontSizeScale}px`;
        }

        function navTo(idx) {
            if(idx < 0 || idx >= BANK_SOAL.length) return;
            state.currentIndex = idx;
            renderQuestion(idx);
            updateSidebarVisuals();
        }
        function navSoal(dir) {
            if(dir === 1 && state.currentIndex === BANK_SOAL.length - 1) {
                confirmSubmit();
            } else {
                navTo(state.currentIndex + dir);
            }
        }

        function renderQuestion(idx) {
            const q = BANK_SOAL[idx];
            const contentArea = get('q-content');
            
            // Topbar
            get('ui-no-soal').innerText = idx + 1;
            get('ui-tipe-soal').innerText = q.type === "PGK" ? "PG Kompleks" : (q.type === "BS" ? "Benar / Salah" : (q.type === "MATCH" ? "Menjodohkan" : "Pilihan Ganda"));
            
