        /* --- LOGIC: INPUT HANDLING --- */
        function handleInput(qId, type, val, isChecked=null) {
            if(type === "PG") {
                state.answers[qId] = parseInt(val);
            } else if (type === "PGK") {
                let arr = state.answers[qId] || [];
                if(isChecked) {
                    if(!arr.includes(val)) arr.push(val);
                } else {
                    arr = arr.filter(v => v !== val);
                }
                state.answers[qId] = arr;
                if(arr.length === 0) delete state.answers[qId]; // clean up empty array
            } else if (type === "BS") {
                // val is like "0_B"
                const [idx, ans] = val.split('_');
                if(!state.answers[qId]) state.answers[qId] = {};
                state.answers[qId][idx] = ans;
            } else if (type === "MATCH") {
                // val is like "0_2"
                const [pIdx, rIdx] = val.split('_');
                if(!state.answers[qId]) state.answers[qId] = {};
                if(rIdx === "") {
                    delete state.answers[qId][pIdx];
                    if(Object.keys(state.answers[qId]).length === 0) delete state.answers[qId];
                } else {
                    state.answers[qId][pIdx] = parseInt(rIdx);
                }
            }
            
            updateSidebarVisuals();
            saveState();
        }

        function toggleRagu(checked) {
            const qId = BANK_SOAL[state.currentIndex].id;
            if(checked) state.ragu[qId] = true;
            else delete state.ragu[qId];
            updateSidebarVisuals();
            saveState();
        }

        /* --- LOGIC: ANTI-CHEAT --- */
        function setupAntiCheat() {
            document.addEventListener('visibilitychange', handleVisibilityChange);
            window.addEventListener('blur', handleBlur);
        }
        function removeAntiCheat() {
            document.removeEventListener('visibilitychange', handleVisibilityChange);
            window.removeEventListener('blur', handleBlur);
        }
        function handleVisibilityChange() {
            if (document.hidden && state.status === "test") triggerViolation();
        }
        function handleBlur() {
            if (state.status === "test") triggerViolation();
        }
        function triggerViolation() {
            state.violations++;
            get('ui-violations').innerText = state.violations;
            show('modal-cheat');
            saveState();
        }

        /* --- LOGIC: SUBMIT & RESULT --- */
        function confirmSubmit() {
            let dijawab = 0, kosong = 0;
            BANK_SOAL.forEach(q => {
                if(state.answers[q.id] !== undefined && state.answers[q.id] !== null && Object.keys(state.answers[q.id] || {}).length > 0) dijawab++;
                else kosong++;
            });
            const ragu = Object.keys(state.ragu).length;
            
            get('fin-dijawab').innerText = dijawab;
            get('fin-belum').innerText = kosong;
            get('fin-ragu').innerText = ragu;
            
            show('modal-finish');
        }

        function closeModal(id) {
            get(id).classList.add('hidden');
        }

        function forceSubmit() {
            closeModal('modal-finish');
            submitExam();
        }

        function submitExam() {
            clearInterval(timerInterval);
            removeAntiCheat();
            state.status = "result";
            closeModal('modal-finish');
            
            // Calculate Score (Simple Logic: Total 100 based on proportion)
            let totalAchieved = 0;
            let totalMax = BANK_SOAL.length; // 25 points total basis
            
            let statBenar = 0, statSalah = 0;
            let rincianSkor = []; // Array untuk menyimpan skor tiap butir soal

            BANK_SOAL.forEach(q => {
                const uAns = state.answers[q.id];
                const cAns = q.answer;
                let qScore = 0;
                
                if(q.type === "PG") {
                    if(uAns === cAns) { totalAchieved++; statBenar++; qScore = 1; }
                    else { statSalah++; qScore = 0; }
                } 
                else if (q.type === "PGK") {
                    if(Array.isArray(uAns)) {
                        // Strict exact match for full point
                        const uSorted = [...uAns].sort();
                        const cSorted = [...cAns].sort();
                        if(JSON.stringify(uSorted) === JSON.stringify(cSorted)) { totalAchieved++; statBenar++; qScore = 1; }
                        else { statSalah++; qScore = 0; }
                    } else { statSalah++; qScore = 0; }
                }
                else if (q.type === "BS") {
                    let correctItems = 0;
                    q.statements.forEach((stmt, i) => {
                        if(uAns && uAns[i] === stmt.a) correctItems++;
                    });
                    qScore = correctItems / q.statements.length;
                    totalAchieved += qScore; // partial
                    if(correctItems === q.statements.length) statBenar++; else statSalah++;
                }
                else if (q.type === "MATCH") {
                    let correctItems = 0;
                    q.premises.forEach((p, i) => {
                        if(uAns && uAns[i] == cAns[i]) correctItems++;
                    });
                    qScore = correctItems / q.premises.length;
                    totalAchieved += qScore; // partial
                    if(correctItems === q.premises.length) statBenar++; else statSalah++;
                }
                rincianSkor.push(qScore.toFixed(2));
            });

            const finalScore = Math.round((totalAchieved / totalMax) * 100);
            
            // Kalkulasi Durasi
            const durasiDetik = (APP_CONFIG.durationMins * 60) - state.timeRemaining;
            const durasiMenit = Math.floor(durasiDetik / 60);
            const sisaDetik = durasiDetik % 60;
            const durasiFormatted = `${durasiMenit}m ${sisaDetik}s`;

            // Save to history (Local)
            const resultRecord = {
                date: new Date().toISOString(),
                nama: state.student.nama,
                kelas: state.student.kelas,
                score: finalScore,
                benar: statBenar,
                salah: statSalah,
                durasi: durasiFormatted,
                rincian: rincianSkor,
                violation: state.violations
            };
            
            let hist = JSON.parse(localStorage.getItem(APP_CONFIG.historyKey) || "[]");
            hist.push(resultRecord);
            localStorage.setItem(APP_CONFIG.historyKey, JSON.stringify(hist));

            // Clear active test state
            localStorage.removeItem(APP_CONFIG.storageKey);

            // Render Result
            get('res-nama').innerText = state.student.nama;
            get('res-kelas').innerText = state.student.kelas;
            get('res-skor').innerText = finalScore;
            get('res-benar').innerText = statBenar;
            get('res-salah').innerText = statSalah;
            get('res-violation').innerText = state.violations;
            
            const today = new Date();
            get('print-date').innerText = `${today.getDate()} ${today.toLocaleString('id', {month:'long'})} ${today.getFullYear()}`;
            get('print-siswa-ttd').innerText = state.student.nama;

            hide('screen-test');
            show('screen-result');
        }

        /* --- LOGIC: WEBHOOK SYNC --- */
        function sendToGoogleSheets() {
            const webhookUrl = localStorage.getItem(APP_CONFIG.webhookKey) || APP_CONFIG.defaultWebhookUrl;
            const statUI = get('sync-status');
            
            if(!webhookUrl) {
                statUI.innerText = "URL Webhook belum diatur oleh Pengawas. Silakan hubungi Guru/Pengawas.";
                statUI.className = "text-center text-sm font-bold mt-4 no-print text-red-600";
                show('sync-status');
                return;
            }

            const btn = get('btn-sync');
            btn.innerHTML = `<i class="ph-bold ph-spinner animate-spin"></i> Mengirim...`;
            btn.disabled = true;

            // Ambil data ujian terakhir yang baru saja di-submit
            const hist = JSON.parse(localStorage.getItem(APP_CONFIG.historyKey) || "[]");
            const latestRecord = hist[hist.length - 1];

            const payload = {
                waktu: new Date(latestRecord.date).toLocaleString('id'),
                nama: latestRecord.nama,
                kelas: latestRecord.kelas,
                durasi: latestRecord.durasi,
                skor: latestRecord.score,
                benar: latestRecord.benar,
                salah: latestRecord.salah,
                pelanggaran: latestRecord.violation,
                rincian: latestRecord.rincian
            };

            fetch(webhookUrl, {
                method: 'POST',
                mode: 'no-cors', // typical for simple GAS setups without explicit headers
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => {
                statUI.innerText = "Berhasil dikirim ke Server!";
                statUI.className = "text-center text-sm font-bold mt-4 no-print text-emerald-600";
                show('sync-status');
                btn.innerHTML = `<i class="ph-bold ph-check"></i> Terkirim`;
            })
            .catch(err => {
                statUI.innerText = "Gagal mengirim. Periksa koneksi internet.";
                statUI.className = "text-center text-sm font-bold mt-4 no-print text-red-600";
                show('sync-status');
                btn.innerHTML = `<i class="ph-bold ph-cloud-arrow-up"></i> Coba Lagi`;
                btn.disabled = false;
            });
        }


        /* --- LOGIC: TEACHER PANEL --- */
        function openTeacherPanel() {
            show('modal-teacher');
            show('teacher-auth');
            hide('teacher-dashboard');
            get('in-pin').value = '';
            hide('err-pin');
        }
        function authTeacher() {
            if(get('in-pin').value === APP_CONFIG.pin) {
                hide('teacher-auth');
                show('teacher-dashboard');
                loadTeacherData();
            } else {
                show('err-pin');
            }
        }
        function loadTeacherData() {
            get('in-webhook').value = localStorage.getItem(APP_CONFIG.webhookKey) || APP_CONFIG.defaultWebhookUrl;
            const hist = JSON.parse(localStorage.getItem(APP_CONFIG.historyKey) || "[]");
            const tbody = get('table-results');
            tbody.innerHTML = "";
            
            if(hist.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400">Belum ada data ujian pada perangkat ini.</td></tr>`;
            } else {
                // Reverse to show latest first
                hist.reverse().forEach(row => {
                    const dt = new Date(row.date);
                    tbody.innerHTML += `
                        <tr class="hover:bg-slate-50">
                            <td class="p-3">${dt.toLocaleTimeString('id', {hour:'2-digit',minute:'2-digit'})}</td>
                            <td class="p-3 font-bold text-slate-800">${row.nama}</td>
                            <td class="p-3">${row.kelas}</td>
                            <td class="p-3 text-center font-bold text-alishlah-teal">${row.score}</td>
                            <td class="p-3 text-center text-red-500">${row.violation > 0 ? row.violation : '-'}</td>
                        </tr>
                    `;
                });
            }
        }
        function saveWebhook() {
            const url = get('in-webhook').value.trim();
            localStorage.setItem(APP_CONFIG.webhookKey, url);
            alert("URL Webhook berhasil disimpan!");
        }
        function resetCurrentSession() {
            if(confirm("Yakin ingin menghapus riwayat ujian lokal di perangkat INI SAJA? (Tindakan ini tidak bisa dibatalkan)")) {
                localStorage.removeItem(APP_CONFIG.historyKey);
                loadTeacherData();
            }
        }
        function downloadCSV() {
            const hist = JSON.parse(localStorage.getItem(APP_CONFIG.historyKey) || "[]");
            if(hist.length === 0) return alert("Data kosong");
            
            let csv = "Waktu,Nama,Kelas,Skor,Benar,Pelanggaran\n";
            hist.forEach(r => {
                csv += `${new Date(r.date).toLocaleString('id')},"${r.nama}","${r.kelas}",${r.score},${r.benar},${r.violation}\n`;
            });
            
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", "Rekap_CBT_SAS_Lokal.csv");
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        /* --- INITIALIZATION --- */
        window.onload = () => {
            loadState();
        };

