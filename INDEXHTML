                    sel += `<option value="">-- Pilih Pasangan --</option>`;
                    q.responses.forEach((resp, j) => {
                        const isSel = ansObj[i] == j ? "selected" : "";
                        sel += `<option value="${j}" ${isSel}>${resp}</option>`;
