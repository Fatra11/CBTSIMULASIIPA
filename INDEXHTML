<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CBT SAS - MTs Terpadu Al Ishlah</title>
    
    <!-- Fonts: Inter (UI) & Amiri (Arabic) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- MathJax for Physics Formulas -->
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']]
            },
            startup: {
                typeset: false // Will trigger manually after DOM updates
            }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <!-- Tailwind Config & Custom CSS -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        alishlah: {
                            teal: '#0d9488',
                            emerald: '#10b981',
                            gold: '#fbbf24',
                            dark: '#0f172a'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        arabic: ['Amiri', 'serif']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f1f5f9; touch-action: manipulation; user-select: none; }
        .font-arabic { font-family: 'Amiri', serif; line-height: 2.5; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        /* Animations */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .fade-in { animation: fadeIn 0.4s ease-out forwards; }
        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .blink-warning { animation: blink 1s infinite; }

        /* Custom Inputs */
        input[type="radio"]:checked + div, input[type="checkbox"]:checked + div {
            border-color: #0d9488; background-color: #f0fdfa;
        }
        input[type="radio"]:checked + div .indicator { background-color: #0d9488; border-color: #0d9488; }
        input[type="checkbox"]:checked + div .indicator { background-color: #0d9488; border-color: #0d9488; }
        
        /* Grid Buttons */
        .btn-nav.answered { background-color: #10b981; color: white; border-color: #059669; }
        .btn-nav.ragu { background-color: #fbbf24; color: #78350f; border-color: #d97706; }
        .btn-nav.active { box-shadow: 0 0 0 3px #0d9488; transform: scale(1.1); z-index: 10; }

        /* Print Styles */
        @media print {
            body { background: white; }
            .no-print, header, nav, #sidebar { display: none !important; }
            #screen-result { display: block !important; position: absolute; left: 0; top: 0; width: 100%; padding: 0; margin: 0; }
            .print-border { border: 1px solid #000; }
            * { user-select: auto; }
        }
    </style>
</head>
<body class="text-slate-800 h-screen w-screen overflow-hidden flex flex-col">

    <!-- ==========================================
         1. SCREEN: LOGIN PORTAL
    =========================================== -->
    <section id="screen-login" class="flex-1 flex flex-col items-center justify-center p-4 bg-gradient-to-br from-slate-900 to-alishlah-teal relative z-10 overflow-y-auto">
        <button onclick="openTeacherPanel()" class="absolute top-4 right-4 text-white/50 hover:text-white transition"><i class="ph-fill ph-lock-key text-2xl"></i></button>
        
        <div class="bg-white rounded-3xl w-full max-w-md p-8 shadow-2xl fade-in">
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-alishlah-teal rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg text-white">
                    <i class="ph-fill ph-student text-3xl"></i>
                </div>
                <h1 class="text-2xl font-black text-slate-800">CBT Simulasi Olimpiade</h1>
                <p class="text-sm font-semibold text-alishlah-teal mt-1">MTs Terpadu Al Ishlah Gorontalo</p>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Nama Lengkap</label>
                    <select id="in-nama" class="w-full p-3 border-2 border-slate-200 rounded-xl focus:border-alishlah-teal focus:ring-0 outline-none transition bg-white" disabled>
                        <option value="">Pilih kelas terlebih dahulu...</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Kelas</label>
                    <select id="in-kelas" onchange="populateNama()" class="w-full p-3 border-2 border-slate-200 rounded-xl focus:border-alishlah-teal focus:ring-0 outline-none transition bg-white">
                        <option value="">Pilih Kelas...</option>
                        <option value="IX Sa'id bin Zaid">IX Sa'id bin Zaid</option>
                        <option value="IX Abu Ubaidah bin Jarrah">IX Abu Ubaidah bin Jarrah</option>
                        <option value="IX Bilal bin Rabbah">IX Bilal bin Rabbah</option>
                        <option value="IX Khalid bin Walid">IX Khalid bin Walid</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Token Ujian <span class="text-xs font-normal text-slate-400">(Tanya Pengawas)</span></label>
                    <input type="password" id="in-token" class="w-full p-3 border-2 border-slate-200 rounded-xl focus:border-alishlah-teal focus:ring-0 outline-none transition text-center tracking-widest font-mono" placeholder="••••••••">
                    <p id="err-login" class="text-red-500 text-xs mt-2 text-center hidden font-bold"></p>
                </div>
                <button onclick="verifyLogin()" class="w-full mt-4 py-3.5 bg-alishlah-gold hover:bg-yellow-500 text-alishlah-dark rounded-xl font-black text-lg transition shadow-md">
                    LOGIN UJIAN
                </button>
            </div>
        </div>
    </section>

    <!-- ==========================================
         2. SCREEN: PAKTA INTEGRITAS
    =========================================== -->
    <section id="screen-pact" class="hidden flex-1 flex-col items-center justify-center p-4 bg-slate-100 overflow-y-auto z-20">
        <div class="bg-white rounded-3xl w-full max-w-2xl p-6 md:p-8 shadow-xl border-t-8 border-alishlah-teal fade-in my-auto">
            <h2 class="text-2xl font-black text-center mb-6 border-b pb-4">Pakta Integritas & Doa</h2>
            
            <div class="bg-teal-50 border border-teal-100 p-4 rounded-2xl mb-6 text-center">
                <p class="font-arabic text-2xl text-slate-800 mb-2">رَبِّ زِدْنِي عِلْمًا وَارْزُقْنِي فَهْمًا</p>
                <p class="text-sm text-slate-600 italic">"Ya Tuhanku, tambahkanlah kepadaku ilmu pengetahuan dan berikanlah kepadaku kepahaman."</p>
            </div>

            <ul class="space-y-3 text-sm text-slate-700 mb-6 bg-slate-50 p-5 rounded-2xl border border-slate-200">
                <li class="flex items-start gap-2"><i class="ph-fill ph-check-circle text-alishlah-emerald mt-0.5"></i> Saya mengerjakan ujian ini dengan jujur dan mandiri.</li>
                <li class="flex items-start gap-2"><i class="ph-fill ph-warning text-alishlah-gold mt-0.5"></i> <b>Sistem Anti-Cheat Aktif:</b> Keluar dari layar ujian atau membuka tab lain akan dicatat sebagai pelanggaran.</li>
                <li class="flex items-start gap-2"><i class="ph-fill ph-floppy-disk text-blue-500 mt-0.5"></i> Jawaban tersimpan otomatis. Jika terputus, Anda bisa login kembali.</li>
                <li class="flex items-start gap-2"><i class="ph-fill ph-clock text-purple-500 mt-0.5"></i> Durasi ujian: <b>90 Menit</b>. Waktu terus berjalan meskipun aplikasi tertutup.</li>
            </ul>

            <label class="flex items-start gap-3 p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 transition mb-6">
                <input type="checkbox" id="chk-pact" class="w-5 h-5 text-alishlah-teal rounded border-slate-300 focus:ring-alishlah-teal mt-0.5" onchange="document.getElementById('btn-start').disabled = !this.checked">
                <span class="text-sm font-bold text-slate-800">Bismillah, saya bersedia mematuhi peraturan dan siap mengerjakan ujian secara jujur karena Allah SWT.</span>
            </label>

            <button id="btn-start" disabled onclick="startExam()" class="w-full py-4 bg-alishlah-teal disabled:bg-slate-300 disabled:text-slate-500 text-white rounded-xl font-black text-lg transition shadow-md flex items-center justify-center gap-2">
                MULAI UJIAN SEKARANG <i class="ph-bold ph-arrow-right"></i>
            </button>
        </div>
    </section>

    <!-- ==========================================
         3. SCREEN: WORKSPACE UJIAN
    =========================================== -->
    <section id="screen-test" class="hidden flex-1 flex-col bg-slate-50 overflow-hidden relative z-30 h-full w-full">
        <!-- Top Bar -->
        <header class="bg-alishlah-teal text-white px-4 py-3 shrink-0 flex justify-between items-center shadow-md relative z-40">
            <div class="flex items-center gap-3">
                <button onclick="toggleSidebar()" class="md:hidden p-1.5 bg-white/20 rounded-lg"><i class="ph-bold ph-list text-xl"></i></button>
                <div>
                    <h1 class="font-bold text-sm md:text-base leading-tight">CBT Simulasi Olimpiade</h1>
                    <p class="text-xs opacity-80" id="ui-student-name">Peserta</p>
                </div>
            </div>
            <div class="flex items-center gap-3 md:gap-6">
                <!-- Violations -->
                <div class="hidden md:flex items-center gap-1.5 text-xs font-bold bg-white/20 px-3 py-1.5 rounded-full" id="ui-violation-badge">
                    <i class="ph-fill ph-warning-circle text-yellow-300"></i> <span id="ui-violations">0</span> Pelanggaran
                </div>
                <!-- Timer -->
                <div class="flex items-center gap-2 bg-slate-900/40 px-3 py-1.5 rounded-lg border border-white/10" id="ui-timer-box">
                    <i class="ph-bold ph-timer text-lg"></i>
                    <span id="ui-timer" class="font-mono font-bold text-lg md:text-xl tracking-wider">00:00:00</span>
                </div>
            </div>
        </header>

        <div class="flex flex-1 overflow-hidden relative">
            <!-- Sidebar Grid (Desktop: static, Mobile: absolute drawer) -->
            <aside id="sidebar" class="absolute md:static inset-y-0 left-0 w-72 bg-white border-r border-slate-200 shadow-2xl md:shadow-none transform -translate-x-full md:translate-x-0 transition-transform duration-300 z-50 flex flex-col shrink-0">
                <div class="p-4 border-b bg-slate-50 flex justify-between items-center">
                    <h3 class="font-bold text-slate-700">Daftar Soal</h3>
                    <button onclick="toggleSidebar()" class="md:hidden text-slate-500"><i class="ph-bold ph-x text-xl"></i></button>
                </div>
                <div class="flex-1 overflow-y-auto p-4">
                    <div class="grid grid-cols-5 gap-2" id="grid-soal">
                        <!-- Injected via JS -->
                    </div>
                </div>
                <div class="p-4 border-t bg-slate-50 text-xs font-semibold text-slate-600 space-y-2">
                    <div class="flex items-center gap-2"><div class="w-3 h-3 rounded bg-white border border-slate-300"></div> Belum Dijawab</div>
                    <div class="flex items-center gap-2"><div class="w-3 h-3 rounded bg-alishlah-emerald border border-emerald-600"></div> Sudah Dijawab</div>
                    <div class="flex items-center gap-2"><div class="w-3 h-3 rounded bg-alishlah-gold border border-amber-600"></div> Ragu-ragu</div>
                </div>
            </aside>

            <!-- Main Question Area -->
            <main class="flex-1 flex flex-col overflow-hidden relative" onclick="closeSidebarMobile()">
                <div class="flex-1 overflow-y-auto p-4 md:p-8 relative no-scrollbar" id="main-scroll-area">
                    <div class="max-w-3xl mx-auto">
                        <!-- Question Header -->
                        <div class="flex justify-between items-center mb-6">
                            <div class="flex gap-2">
                                <span class="bg-alishlah-teal text-white px-3 py-1 rounded-lg font-black text-lg">Soal <span id="ui-no-soal">1</span></span>
                                <span id="ui-tipe-soal" class="bg-blue-100 text-blue-800 px-3 py-1 rounded-lg font-bold text-sm flex items-center">PG</span>
                            </div>
                            <!-- Font Resize Tools -->
                            <div class="flex bg-white rounded-lg border border-slate-200 overflow-hidden shadow-sm">
                                <button onclick="changeFontSize(-1)" class="px-3 py-1 hover:bg-slate-100 text-slate-600 font-bold border-r">A-</button>
                                <button onclick="changeFontSize(0)" class="px-3 py-1 hover:bg-slate-100 text-slate-600 font-bold border-r text-sm">A</button>
                                <button onclick="changeFontSize(1)" class="px-3 py-1 hover:bg-slate-100 text-slate-600 font-bold">A+</button>
                            </div>
                        </div>

                        <!-- Content Render Area -->
                        <div id="q-content" class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200 text-[16px] leading-relaxed text-slate-800 transition-all duration-300">
                            <!-- Injected via JS -->
                        </div>
                    </div>
                </div>

                <!-- Bottom Navigation -->
                <nav class="bg-white border-t border-slate-200 p-4 shrink-0 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-40">
                    <div class="max-w-3xl mx-auto flex justify-between items-center">
                        <button onclick="navSoal(-1)" id="btn-prev" class="px-4 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold transition flex items-center gap-1 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="ph-bold ph-caret-left"></i> <span class="hidden sm:inline">Sebelumnya</span>
                        </button>
                        
                        <label class="flex items-center gap-2 px-4 py-3 bg-yellow-50 hover:bg-yellow-100 text-yellow-700 border border-yellow-300 rounded-xl font-bold cursor-pointer transition">
                            <input type="checkbox" id="chk-ragu" class="w-5 h-5 rounded text-yellow-500 focus:ring-yellow-400" onchange="toggleRagu(this.checked)">
                            Ragu-ragu
                        </label>
                        
                        <button onclick="navSoal(1)" id="btn-next" class="px-6 py-3 bg-alishlah-teal hover:bg-teal-700 text-white rounded-xl font-bold transition flex items-center gap-1">
                            <span class="hidden sm:inline">Selanjutnya</span> <i class="ph-bold ph-caret-right"></i>
                        </button>
                    </div>
                </nav>
            </main>
        </div>
    </section>

    <!-- Modal Konfirmasi Selesai -->
    <div id="modal-finish" class="hidden fixed inset-0 bg-black/60 z-[70] backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl w-full max-w-md p-6 shadow-2xl transform scale-95 transition-all text-center">
            <div class="w-16 h-16 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="ph-fill ph-warning-octagon text-3xl"></i>
            </div>
            <h3 class="text-xl font-black mb-2">Selesai Ujian?</h3>
            <p class="text-sm text-slate-600 mb-6">Pastikan semua soal telah terjawab. Anda tidak dapat kembali setelah mengirim jawaban.</p>
            
            <div class="grid grid-cols-3 gap-2 mb-6 text-sm">
                <div class="bg-emerald-50 p-2 rounded-lg border border-emerald-100"><div class="font-bold text-emerald-600 text-lg" id="fin-dijawab">0</div>Terjawab</div>
                <div class="bg-slate-50 p-2 rounded-lg border border-slate-200"><div class="font-bold text-slate-600 text-lg" id="fin-belum">0</div>Kosong</div>
                <div class="bg-yellow-50 p-2 rounded-lg border border-yellow-200"><div class="font-bold text-yellow-600 text-lg" id="fin-ragu">0</div>Ragu</div>
            </div>

            <div class="flex gap-3">
                <button onclick="closeModal('modal-finish')" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 rounded-xl font-bold transition">Batal</button>
                <button onclick="submitExam()" class="flex-1 py-3 bg-red-500 hover:bg-red-600 text-white rounded-xl font-bold transition flex items-center justify-center gap-2"><i class="ph-bold ph-paper-plane-tilt"></i> Kirim</button>
            </div>
        </div>
    </div>

    <!-- Modal Peringatan Pelanggaran -->
    <div id="modal-cheat" class="hidden fixed inset-0 bg-black/80 z-[80] backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl w-full max-w-md p-8 shadow-2xl text-center border-t-8 border-red-600">
            <i class="ph-fill ph-warning-diamond text-red-500 text-6xl mb-4 blink-warning"></i>
            <h3 class="text-2xl font-black text-red-600 mb-2">PERINGATAN PELANGGARAN!</h3>
            <p class="text-slate-700 mb-6 font-semibold">Anda terdeteksi meninggalkan layar ujian. Aktivitas ini tercatat di sistem sebagai bentuk pelanggaran (Kecurangan).</p>
            <button onclick="closeModal('modal-cheat'); requestFullscreen();" class="w-full py-4 bg-red-600 text-white rounded-xl font-black text-lg shadow-lg">SAYA MENGERTI</button>
        </div>
    </div>

    <!-- ==========================================
         4. SCREEN: HASIL & REKAP
    =========================================== -->
    <section id="screen-result" class="hidden flex-1 overflow-y-auto p-4 md:p-8 bg-slate-100 relative z-[60]">
        <!-- KOP SURAT (Print Only) -->
        <div class="hidden print:block text-center border-b-2 border-black pb-4 mb-6">
            <h1 class="text-xl font-bold uppercase">KEMENTERIAN AGAMA REPUBLIK INDONESIA</h1>
            <h2 class="text-2xl font-black">MTs TERPADU AL ISHLAH GORONTALO</h2>
            <p class="text-sm">Asesmen Sumatif Akhir Semester (SAS) Berbasis Komputer</p>
            <h3 class="text-lg font-bold mt-4 underline">KARTU BUKTI PELAKSANAAN UJIAN</h3>
        </div>

        <div class="max-w-2xl mx-auto">
            <div class="bg-gradient-to-br from-alishlah-teal to-emerald-600 rounded-3xl p-6 md:p-8 text-white shadow-xl mb-6 no-print flex items-center gap-4">
                <i class="ph-fill ph-check-circle text-5xl text-emerald-200"></i>
                <div>
                    <h2 class="text-2xl font-black mb-1">Ujian Selesai!</h2>
                    <p class="opacity-90">Alhamdulillah, jawaban Anda telah tersimpan.</p>
                </div>
            </div>

            <div class="bg-white rounded-3xl p-6 md:p-8 shadow-md border border-slate-200 mb-6 print-border">
                <h3 class="font-bold text-slate-800 text-lg mb-4 border-b pb-2">Identitas Peserta</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm mb-6">
                    <div><span class="text-slate-500 block mb-1">Nama Lengkap</span><strong class="text-base" id="res-nama">-</strong></div>
                    <div><span class="text-slate-500 block mb-1">Kelas</span><strong class="text-base" id="res-kelas">-</strong></div>
                    <div><span class="text-slate-500 block mb-1">Mata Pelajaran</span><strong class="text-base">IPA (Latihan OSN)</strong></div>
                </div>

                <h3 class="font-bold text-slate-800 text-lg mb-4 border-b pb-2">Rekapitulasi Hasil</h3>
                <div class="flex flex-col md:flex-row gap-4 mb-6">
                    <div class="flex-1 bg-slate-50 rounded-2xl p-6 text-center border print-border">
                        <span class="text-slate-500 font-bold block mb-2">Nilai Akhir</span>
                        <div class="text-6xl font-black text-alishlah-teal" id="res-skor">0</div>
                    </div>
                    <div class="flex-1 flex flex-col gap-3">
                        <div class="bg-emerald-50 rounded-xl p-3 border border-emerald-100 flex justify-between items-center"><span class="font-bold text-emerald-800">Soal Benar</span><span class="font-black text-emerald-600 text-xl" id="res-benar">0</span></div>
                        <div class="bg-red-50 rounded-xl p-3 border border-red-100 flex justify-between items-center"><span class="font-bold text-red-800">Soal Salah/Kosong</span><span class="font-black text-red-600 text-xl" id="res-salah">0</span></div>
                        <div class="bg-yellow-50 rounded-xl p-3 border border-yellow-200 flex justify-between items-center"><span class="font-bold text-yellow-800">Pelanggaran Sistem</span><span class="font-black text-yellow-600 text-xl" id="res-violation">0</span></div>
                    </div>
                </div>

                <div class="hidden print:flex justify-between mt-12 text-sm">
                    <div class="text-center"><p class="mb-16">Mengetahui,<br>Pengawas Ruangan</p><p class="font-bold underline">.........................</p></div>
                    <div class="text-center"><p class="mb-16">Gorontalo, <span id="print-date"></span><br>Peserta Ujian,</p><p class="font-bold underline" id="print-siswa-ttd"></p></div>
                </div>
            </div>

            <div class="flex flex-col md:flex-row gap-3 no-print">
                <button onclick="window.print()" class="flex-1 py-3 bg-slate-800 hover:bg-slate-900 text-white rounded-xl font-bold transition flex items-center justify-center gap-2"><i class="ph-bold ph-printer"></i> Cetak Bukti PDF</button>
                <button onclick="sendToGoogleSheets()" id="btn-sync" class="flex-1 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition flex items-center justify-center gap-2"><i class="ph-bold ph-cloud-arrow-up"></i> Sinkron Nilai Server</button>
            </div>
            <p id="sync-status" class="text-center text-sm font-bold mt-4 no-print hidden"></p>
        </div>
    </section>

    <!-- ==========================================
         5. PANEL GURU / PENGAWAS
    =========================================== -->
    <div id="modal-teacher" class="hidden fixed inset-0 bg-slate-900/90 z-[90] flex items-center justify-center p-4 overflow-y-auto">
        <div id="teacher-auth" class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl fade-in text-center">
            <i class="ph-fill ph-lock-key text-4xl text-alishlah-teal mb-4"></i>
            <h3 class="text-xl font-bold mb-4">Otorisasi Pengawas</h3>
            <input type="password" id="in-pin" class="w-full p-3 border-2 border-slate-200 rounded-xl mb-4 text-center tracking-widest font-mono text-xl" placeholder="PIN" maxlength="4">
            <p id="err-pin" class="text-red-500 text-xs mb-4 hidden font-bold">PIN Salah!</p>
            <div class="flex gap-2">
                <button onclick="closeModal('modal-teacher')" class="flex-1 py-3 bg-slate-100 rounded-xl font-bold">Batal</button>
                <button onclick="authTeacher()" class="flex-1 py-3 bg-alishlah-teal text-white rounded-xl font-bold">Masuk</button>
