                });
                html += `</div>`;
            } 
            else if (q.type === "PGK") {
                html += `<div class="bg-blue-50 text-blue-800 text-sm p-3 rounded-lg mb-4 font-bold"><i class="ph-fill ph-info"></i> Petunjuk: Pilih lebih dari satu jawaban yang benar.</div>`;
                html += `<div class="space-y-3">`;
                const ansArr = Array.isArray(userAns) ? userAns : [];
                q.options.forEach((opt, i) => {
                    const isChecked = ansArr.includes(i) ? "checked" : "";
                    html += `
                        <label class="relative flex items-start p-4 rounded-xl border-2 border-slate-200 cursor-pointer hover:bg-slate-50 transition group">
                            <input type="checkbox" name="q_${q.id}" value="${i}" ${isChecked} onchange="handleInput(${q.id}, 'PGK', ${i}, this.checked)" class="absolute opacity-0">
